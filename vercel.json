{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": ".",
      "framework": "flask",
      "bindings": [
        {
          "type": "service",
          "service": "song",
          "format": "url",
          "env": "SONG_SERVICE_URL"
        }
      ]
    },
    "downloader": {
      "root": "downloader_service",
      "framework": "flask"
    },
    "song": {
      "root": "song_service",
      "framework": "flask",
      "installCommand": "python -m pip install --no-cache-dir -r requirements-vercel.txt",
      "bindings": [
        {
          "type": "service",
          "service": "voice",
          "format": "url",
          "env": "VOICE_SERVICE"
        },
        {
          "type": "service",
          "service": "downloader",
          "format": "url",
          "env": "DOWNLOADER_URL"
        }
      ]
    },
    "voice": {
      "root": "voice_service",
      "framework": "flask",
      "installCommand": "python -m pip install --no-cache-dir -r requirements-vercel.txt"
    }
  },
  "rewrites": [
    {
      "source": "/song/(.*)",
      "destination": {
        "service": "song"
      }
    },
    {
      "source": "/voice/(.*)",
      "destination": {
        "service": "voice"
      }
    },
    {
      "source": "/downloader/(.*)",
      "destination": {
        "service": "downloader"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "site"
      }
    }
  ]
}
